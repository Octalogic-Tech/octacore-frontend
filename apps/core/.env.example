VITE_API_URL=http://localhost:3001
# The FastAPI core service (octacore-backend). Address it as `localhost`, like the app, never 127.0.0.1: the
# refresh cookie only travels between same-site addresses, so a mix signs you out on every reload. The service
# listens on IPv4 only by default; for a Cypress run against it (Electron resolves localhost to ::1 and does not
# fall back), serve it on ::1 with `uvicorn ... --host ::1`.
VITE_CORE_API_URL=http://localhost:5001/api/v1
